{
  "name": "@janjacord/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "electron .",
    "test": "echo 'desktop smoke via start'",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@janjacord/crypto": "workspace:*",
    "@janjacord/crypto-core": "workspace:*",
    "@janjacord/identity": "workspace:*",
    "@janjacord/networking": "workspace:*",
    "@janjacord/persistence": "workspace:*",
    "@janjacord/protocol": "workspace:*",
    "@janjacord/schemas": "workspace:*",
    "node-datachannel": "^0.32.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "br.janjacord.app",
    "productName": "JanjaCord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://updates.janjacord.example.com/janjacord",
      "channel": "latest"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  }
}