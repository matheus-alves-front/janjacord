# Copying this file is not the recommended setup. Run ./scripts/init.sh instead.
# These are documentation-safe examples only; no real secret belongs in this file.
COMPOSE_PROJECT_NAME=janjabridge
JANJABRIDGE_UID=1000
JANJABRIDGE_GID=1000
BRIDGE_DOMAIN=bridge.example.com
TURN_DOMAIN=turn.bridge.example.com
ACME_EMAIL=ops@example.com
ACME_STAGING=false

# coturn advertises this public IPv4 address in relay candidates.
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=bridge.example.com
TURN_PORT=3478
TURN_TLS_PORT=443
TURN_TLS_INTERNAL_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_USER_QUOTA=4
TURN_TOTAL_QUOTA=100
TURN_MAX_BPS=4000000
TURN_BPS_CAPACITY=50000000

JC_RENDEZVOUS_MAX_TTL_MS=300000
JC_RENDEZVOUS_RATE_LIMIT=120

# Override JANJABRIDGE_IMAGE to deploy a prebuilt compatible image. If it is
# absent locally, Compose can build apps/rendezvous from this repository.
JANJABRIDGE_IMAGE=janjacord/rendezvous:local
NODE_IMAGE=node:24.17.0-alpine3.23@sha256:7c70d1235c0b4c2bc9eeed5393d19f1bbdde6885ba0d58ba62bb385d7b0f3ff1
NGINX_IMAGE=nginx:1.28.3-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
COTURN_IMAGE=coturn/coturn:4.15.0-r0@sha256:0feee4fc1f45c7c053c8fee3e1ab941b1a1b9a0429bc01e18126735410770bfd
CERTBOT_IMAGE=certbot/certbot:v5.7.0@sha256:34ee91d2f43008eb78a007d22f23ed4b2eaa9a454cb27ca2c042b49527a695b4

RENDEZVOUS_MEMORY=256m
RENDEZVOUS_CPUS=1.0
GATEWAY_MEMORY=128m
GATEWAY_CPUS=0.5
COTURN_MEMORY=512m
COTURN_CPUS=2.0
